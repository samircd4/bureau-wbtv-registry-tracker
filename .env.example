# ==============================================================================
# Telegram Bot Configuration for Bureau Wbtv Language Search Monitor
# ==============================================================================
#
# Follow these 2 simple steps to get your credentials:
#
# Step 1: Get TELEGRAM_BOT_TOKEN
#   - Open Telegram and search for "@BotFather"
#   - Send "/newbot" and follow the instructions to choose a name and username
#   - BotFather will give you a token (looks like: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
#   - Paste that token below.
#
# Step 2: Get TELEGRAM_CHAT_ID
#   - Open Telegram and search for "@userinfobot"
#   - Start the bot, and it will reply with your personal Telegram "Id" (a number like: 987654321)
#   - Send a quick "/start" or "hello" message to your new bot (created in Step 1) so it has permission to message you
#   - Paste that ID below.
#
# Once filled in, save this file as ".env" (without the .example extension).
# ==============================================================================

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Monitoring interval in seconds (3600 seconds = 1 hour)
MONITOR_INTERVAL_SECONDS=3600

# Email Configuration (for test_mail.py / notifications)
SENDER_EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
RECIPIENT_EMAIL=recipient@example.com

